{
  "name": "markvia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test",
    "build": "pnpm -r --if-present run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:check": "changeset status --since=release",
    "docs:dev": "pnpm --filter @markvia/docs dev",
    "docs:build": "pnpm --filter @markvia/docs build",
    "docs:preview": "pnpm --filter @markvia/docs preview"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vue/server-renderer": "^3.5.42",
    "parse5": "^7.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite-plus": "^0.3.0",
    "vue": "^3.5.42"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.0"
}
