{
  "name": "markvia",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/litingyes/markvia.git"
  },
  "type": "module",
  "scripts": {
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "build": "pnpm -r --if-present run build",
    "release": "tsx scripts/release.ts",
    "docs:dev": "pnpm --filter @markvia/docs dev",
    "docs:build": "pnpm --filter @markvia/docs build",
    "docs:preview": "pnpm --filter @markvia/docs preview"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/server-renderer": "^3.5.42",
    "bumpp": "^12.2.2",
    "changelogen": "^0.6.2",
    "happy-dom": "^20.13.1",
    "parse5": "^7.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite-plus": "^0.3.0",
    "vitest": "4.1.11",
    "vue": "^3.5.42"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
