{
  "name": "@markvia/vue",
  "version": "0.0.0",
  "description": "Vue renderer for Markvia",
  "bugs": {
    "url": "https://github.com/litingyes/markvia/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/litingyes/markvia.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts"
  },
  "dependencies": {
    "@markvia/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  }
}
