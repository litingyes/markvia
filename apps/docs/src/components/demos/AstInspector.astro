---
import { createMarkdown } from '@markvia/core'
import { demoCopy, type DemoLocale } from './demoCopy'

interface Props {
  content: string
  locale?: DemoLocale
}

const { content, locale = 'en' } = Astro.props
const copy = demoCopy[locale]
const runtime = createMarkdown()
const document = runtime.parse(content)
const ir = runtime.toIR(document)
const snapshot = JSON.stringify({ document, ir }, null, 2)
---

<div class="my-4 rounded-xl border border-markvia-border bg-markvia-surface p-4">
  <div class="mb-3 text-xs font-bold uppercase tracking-wider text-markvia-muted">
    {copy.astLabel}
  </div>
  <details>
    <summary>{copy.astSummary}</summary>
    <pre
      class="max-h-96 overflow-auto whitespace-pre-wrap break-words text-sm text-markvia-subtle"
    ><code>{snapshot}</code></pre>
  </details>
</div>
